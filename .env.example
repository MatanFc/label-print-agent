# Copy to .env on each machine and fill in. .env is per-machine and is never copied between them.

# Port the agent listens on (always bound to 127.0.0.1 only).
PORT=9123

# Exact printer queue name. Run `npm start` once and open http://127.0.0.1:9123/ to see the names,
# or: macOS `lpstat -e`, Windows PowerShell `Get-Printer | Select Name`.
PRINTER_NAME=Brother_QL_1100

# portrait | landscape. landscape turns the PDF 90 degrees onto the label, e.g. a 100 x 62 mm
# design on a 62 mm roll. Default: portrait.
ORIENTATION=landscape

# Comma-separated website origins allowed to print (scheme + host + port, no trailing slash).
ALLOWED_ORIGINS=https://your-site.example,http://localhost:3000

# Windows only: full path to SumatraPDF.exe (portable build is fine).
# SUMATRA_PATH=C:\label-print-agent\SumatraPDF.exe

# Windows only: how SumatraPDF fits the PDF onto the label - noscale | fit | shrink.
# PRINT_SCALE=noscale

# macOS only: extra `lp -o` options, comma-separated. media= must match the loaded roll
# (list sizes with `lpoptions -p <PRINTER_NAME> -l`); media=62mm is the DK-2205 62 mm continuous roll.
# LP_OPTIONS=media=62mm

# Testing without the printer: save each received PDF into this folder instead of printing.
# DRY_RUN_DIR=./dry-run-output
